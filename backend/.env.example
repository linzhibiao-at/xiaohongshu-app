# ---- 基础 ----
DATABASE_URL=mysql+aiomysql://root:your-password@127.0.0.1:3306/xhs_ops?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/2
# 必须改成随机长字符串
JWT_SECRET=change-me-to-a-long-random-string

# 首次启动时自动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- 大模型（AgentScope）----
# anthropic | dashscope | openai ; 留空 API key 时 agent 走离线模板兜底
LLM_PROVIDER=openai
LLM_MODEL=glm-5-3-flash-260828
LLM_API_KEY=your-ark-api-key
# openai 兼容网关可填 base url
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- E2B 沙箱 https://console.e2b.dev/----
E2B_API_KEY=your-e2b-api-key

# ---- 小红书连接器 ----
# mock：内置的模拟连接器（不访问小红书）。接入真实渠道时实现 app/xhs/base.py 的接口并在此填写注册名
XHS_CONNECTOR=mock

# ---- 微信登录（公众号网页授权）----
# mock：本地模拟授权，不访问微信、无需 appid（默认）；live：走真实公众号网页授权
# 切 live 前需要：认证服务号 + ICP 备案并在公众平台配置「网页授权域名」（本地调试可用公众号测试号）
WECHAT_MODE=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# mock 模式下固定使用的 openid / 昵称，重复登录复用同一账号
WECHAT_MOCK_OPENID=mock_openid_dev
WECHAT_MOCK_NICKNAME=微信测试用户
# 授权完成后的前端回跳地址（必须是 client 可访问的 origin，不带结尾斜杠）
CLIENT_BASE_URL=http://localhost:5173

# ---- 互动任务风控 ----
INTERACTION_DAILY_LIMIT=60
INTERACTION_MIN_INTERVAL_SECONDS=45
